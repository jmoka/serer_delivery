SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=
MCP_MODE=

# CORS — domínios base da plataforma (separados por vírgula, sem protocolo).
# Domínios White Label por loja (restaurants.custom_domain) vêm do banco
# automaticamente, não precisam entrar aqui.
APP_ALLOWED_ORIGINS=
# Cache (catálogo público /r/*) — senha com caracteres especiais precisa URL-encode (@ -> %40)
REDIS_URL=
# Motoboy (login próprio, JWT — não usa Supabase Auth)
MOTOBOY_JWT_SECRET=
NOMINATIM_USER_AGENT=

# Garçom / módulo Salão (login próprio, JWT — não usa Supabase Auth)
GARCOM_JWT_SECRET=

# Autenticação em duas etapas (2FA) — envio do código por email quando o
# admin/dono de restaurante escolhe o método "email" em vez de app autenticador.
RESEND_API_KEY=

# PagBank
PAGBANK_TOKEN=
PAGBANK_SANDBOX=true
PAGBANK_WEBHOOK_URL=h

# Stripe Connect (Express) — chave da CONTA PLATAFORMA (não é por restaurante,
# o dono da loja nunca digita nada, só clica "Conectar com Stripe"). Webhook
# secret vem de Dashboard > Developers > Webhooks ao cadastrar a URL abaixo.
# Preencher aqui é só fallback — o normal é cadastrar em Admin > Configurações.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 

CLOUDFLARE_TUNNEL_TOKEN=

# Licenciamento — só preencher em instalação local/individual vendida (não na
# instalação central multi-tenant). Serial gerado em Admin > Planos > Instalações
# Locais. Deixe os dois vazios se não for uma instalação licenciada.
LICENCA_SERIAL=
LICENCA_CENTRAL_URL=
# De quanto em quanto tempo (minutos) a instalação confirma a licença com a central
LICENCA_CHECKIN_INTERVALO_MIN=5

N8N_URL=
N8N_EMAIL=j
N8N_SENHA=
N8N_API=
#api_somente 7 dias

# Bot de notificações (pedido confirmado/entregue pro cliente, pedido pronto
# pro motoboy) — token do BotFather, username sem @, secret aleatório usado
# pra validar o header do webhook, URL completa (mesmo padrão do PAGBANK_WEBHOOK_URL).
TELEGRAM_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=