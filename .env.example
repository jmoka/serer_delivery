SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3002
MCP_MODE=

# CORS — domínios base da plataforma (separados por vírgula, sem protocolo).
# Domínios White Label por loja (restaurants.custom_domain) vêm do banco
# automaticamente, não precisam entrar aqui.
APP_ALLOWED_ORIGINS=pediuvai.com.br,deliveryhub.teusite.top

# Cache (catálogo público /r/*) — senha com caracteres especiais precisa URL-encode (@ -> %40)
REDIS_URL=redis://default:senha@host:6379

# Motoboy (login próprio, JWT — não usa Supabase Auth)
MOTOBOY_JWT_SECRET=
NOMINATIM_USER_AGENT=PediuVai/1.0 (seu-email@dominio.com)

# Garçom / módulo Salão (login próprio, JWT — não usa Supabase Auth)
GARCOM_JWT_SECRET=

# Autenticação em duas etapas (2FA) — envio do código por email quando o
# admin/dono de restaurante escolhe o método "email" em vez de app autenticador.
RESEND_API_KEY=

# PagBank
PAGBANK_TOKEN=
PAGBANK_SANDBOX=true
PAGBANK_WEBHOOK_URL=https://app-desenvolvimento-server-delivery.ubjifz.easypanel.host/pagamentos/webhook

CLOUDFLARE_TUNNEL_TOKEN=

# Licenciamento — só preencher em instalação local/individual vendida (não na
# instalação central multi-tenant). Serial gerado em Admin > Planos > Instalações
# Locais. Deixe os dois vazios se não for uma instalação licenciada.
LICENCA_SERIAL=
LICENCA_CENTRAL_URL=https://app-desenvolvimento-server-delivery.ubjifz.easypanel.host
# De quanto em quanto tempo (minutos) a instalação confirma a licença com a central
LICENCA_CHECKIN_INTERVALO_MIN=5